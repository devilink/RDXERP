# Supabase dashboard > Connect. Replace [PROJECT-REF], [PASSWORD] and [REGION].
# Copy the host from Supabase if it differs from the one shown here.
# If the password contains symbols such as @ / : # ? they must be URL-encoded.

# "Transaction pooler" string (port 6543), keeping the options after the "?". Used by the app.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# "Session pooler" string (port 5432). Used only when creating or changing tables.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Signs login sessions. Keep it private and use a different value on the live site.
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Timezone that decides "today" for attendance, overdue fees and daily collections.
APP_TIMEZONE="Asia/Kolkata"
